# Production environment contract
# Required in all environments: development, staging, production
VITE_APP_ENV="development"
VITE_WEB3FORMS_ACCESS_KEY="YOUR_WEB3FORMS_ACCESS_KEY_HERE"
VITE_ENABLE_ANALYTICS="false"

# Optional app metadata
VITE_APP_TITLE="Ascendancy Solutions"
VITE_API_BASE_URL="https://api.web3forms.com/submit"

# Environment policy
# - VITE_WEB3FORMS_ACCESS_KEY must be set in production and staging.
# - This app fails fast if the key is missing or still set to the placeholder value.
# - VITE_APP_ENV must be one of: development, staging, production.
